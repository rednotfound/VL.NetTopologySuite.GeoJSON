<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>VL.NetTopologySuite.GeoJSON</id>
    <version>0.0.1-alpha</version>
    <title>VL.NetTopologySuite.GeoJSON — GeoJSON for NetTopologySuite in vvvv gamma</title>
    <authors>VL.NetTopologySuite.GeoJSON Contributors</authors>
    <owners>VL.NetTopologySuite.GeoJSON Contributors</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/rednotfound/VL.NetTopologySuite.GeoJSON</projectUrl>
    <description>
      EARLY - not ready for real work yet.

      GeoJSON for VL.NetTopologySuite. Read GeoJSON turns GeoJSON text into a spread of
      NetTopologySuite features; Write GeoJSON turns features back into text. Both sit in
      NetTopologySuite.IO, beside Read WKT and Write WKT.

      The features are NetTopologySuite's own Feature type, not a wrapper. VL.NetTopologySuite
      (installed with this package) opens them with Split and GetAttribute and operates on their
      geometry; VL.Mapsui draws them on a map. No adapter anywhere in that chain.

      Reads RFC 7946 GeoJSON. Decoded geometry gets SRID 4326, which the format mandates; a
      Factory pin overrides it. Nothing here reprojects anything.

      Requires vvvv gamma 7.2 or newer (.NET 8).
    </description>
    <summary>GeoJSON reading and writing for VL.NetTopologySuite, as nodes for vvvv gamma.</summary>
    <releaseNotes>
      0.0.1-alpha - First package, developed as VL.GeoJSON until 2026-10-18. Not published.
    </releaseNotes>
    <copyright>Copyright 2026 VL.NetTopologySuite.GeoJSON Contributors</copyright>
    <!-- The "VL" tag is what makes the pack discoverable at https://vvvv.org/packs -->
    <tags>VL vvvv gamma geojson gis json io geometry feature nts nettopologysuite spatial</tags>
    <repository type="git" url="https://github.com/rednotfound/VL.NetTopologySuite.GeoJSON" />

    <!--
      Must match the NugetDependency lines in VL.NetTopologySuite.GeoJSON.vl. The .vl is what teaches VL the
      types; the nuspec is what makes the package resolvable for a consumer. Both are needed and
      neither is sufficient alone.

      This matters more here than in most packages: EVERY node in this assembly mentions an NTS
      or NTS.Features type in its signature, so if those are not resolvable the package
      contributes nothing at all rather than losing a few nodes - and vvvvc still exits 0 with
      nothing red.

      NetTopologySuite.Features is declared although GeoJSON4STJ already drags it in, because VL
      resolves types from packages that are PRESENT, not from a restore graph.

      VL.Core and VL.CoreLib are deliberately absent: they ship inside vvvv, which substitutes
      its own copies for anything declared here.
    -->
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="NetTopologySuite" version="2.6.0" />
        <dependency id="NetTopologySuite.Features" version="2.1.0" />
        <dependency id="NetTopologySuite.IO.GeoJSON4STJ" version="4.0.0" />
        <!--
          The geometry package this one is the GeoJSON half of. Not needed by any node here - they
          name only upstream types - but by the help: a feature read here is opened with
          VL.NetTopologySuite's Split and GetAttribute, and vvvv does not fetch a missing document
          dependency by itself. Same reasoning, same direction, as VL.Mapsui's dependency on it.

          0.0.3-alpha is the first version with GetAttribute, so this package cannot be published
          before that one is.
        -->
        <dependency id="VL.NetTopologySuite" version="0.0.3-alpha" />
      </group>
    </dependencies>
  </metadata>

  <files>
    <!-- Entry point. Must sit at the package root, no subfolder. -->
    <file src="VL.NetTopologySuite.GeoJSON.vl" target="" />

    <file src="src\VL.NetTopologySuite.GeoJSON\bin\Release\net8.0\VL.NetTopologySuite.GeoJSON.dll" target="lib\net8.0\" />
    <file src="src\VL.NetTopologySuite.GeoJSON\bin\Release\net8.0\VL.NetTopologySuite.GeoJSON.xml" target="lib\net8.0\" />

    <!-- This package's own help patches. target stays help\ because that is where vvvv looks. -->
    <file src="help\VL.NetTopologySuite.GeoJSON\*.vl" target="help\" />

    <!--
      The sample data "HowTo Read a GeoJSON file" points at, with a RELATIVE path. It has to ship,
      or that patch opens with a Path pin aimed at nothing - and a Path IOBox failing is the
      quietest failure in this ecosystem, because an unusable path still looks like a path.

      Its own line rather than a glob over help\**, because the glob above deliberately takes .vl
      and nothing else.
    -->
    <file src="help\VL.NetTopologySuite.GeoJSON\Assets\*.geojson" target="help\Assets\" />

    <!--
      Help.xml orders the help patches in the browser and carries their search tags. It needs its
      own line: the glob above takes .vl and nothing else, so leaving this out would ship the
      patches unordered and untagged with no warning anywhere.
    -->
    <file src="help\VL.NetTopologySuite.GeoJSON\Help.xml" target="help\" />

    <file src="README.md" target="docs\" />
    <file src="docs\ARCHITECTURE.md" target="docs\" />
    <file src="docs\ROADMAP.md" target="docs\" />
  </files>
</package>
