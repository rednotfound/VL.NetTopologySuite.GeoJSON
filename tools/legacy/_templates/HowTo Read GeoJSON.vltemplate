<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="%%doc%%" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="%%dep_corelib%%" Location="VL.CoreLib" Version="2025.7.4" />
  <Patch Id="%%patch%%">
    <Canvas Id="%%canvas%%" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="%%app%%">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="%%app_patch%%">
        <Canvas Id="%%app_canvas%%" CanvasType="Group">
          <Pad Id="%%note%%" Bounds="640,55,460,560" ShowValueBox="true" isIOBox="true" Value="Start here&#xD;&#xA;&#xD;&#xA;Edit the text and everything below follows. Then try breaking it on purpose:&#xD;&#xA;&#xD;&#xA;  delete a closing brace        Status says JsonException&#xD;&#xA;  change Point to Rhombus       Status names the type it did not know&#xD;&#xA;  remove a properties object    the feature still reads, with no properties&#xD;&#xA;  replace it all with {}        Success stays TRUE and you get 0 features&#xD;&#xA;&#xD;&#xA;That last one is worth dwelling on. Valid JSON that simply is not GeoJSON is not an error to the parser - so the COUNT is the only thing that tells you. Nothing throws either way: half-typed text is the normal state of a box somebody is editing.&#xD;&#xA;&#xD;&#xA;Read GeoJSON hands back the features directly. There is no collection object to open first, which is how vvvv's own XML and JSON readers work too - they never give a patch a &quot;document&quot; to unwrap.&#xD;&#xA;&#xD;&#xA;Because it is a Spread, everything VL already knows about spreads works on it: Count and GetSlice below are vvvv's own nodes, not ours.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">12</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="%%pad_text%%" Comment="GeoJSON - edit me" Bounds="60,55,540,70" ShowValueBox="true" isIOBox="true" Value="{&quot;type&quot;:&quot;FeatureCollection&quot;,&quot;features&quot;:[{&quot;type&quot;:&quot;Feature&quot;,&quot;geometry&quot;:{&quot;type&quot;:&quot;Point&quot;,&quot;coordinates&quot;:[13.405,52.52]},&quot;properties&quot;:{&quot;name&quot;:&quot;Berlin&quot;,&quot;population&quot;:3677472}},{&quot;type&quot;:&quot;Feature&quot;,&quot;geometry&quot;:{&quot;type&quot;:&quot;Polygon&quot;,&quot;coordinates&quot;:[[[0,0],[2,0],[2,2],[0,2],[0,0]]]},&quot;properties&quot;:{&quot;name&quot;:&quot;a square&quot;}}]}">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <!--
            A PROCESS node, not an operation, and that is the whole design. Parsing 10,000
            features takes about 160 ms against a frame budget of 16.7, so a node that re-parsed
            every frame would be a patch that never draws again. Watch Parses settle at 1.
          -->
          <Node Bounds="60,145,110,26" Id="%%n_read%%">
            <p:NodeReference LastCategoryFullName="GeoJSON" LastDependency="VL.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Read GeoJSON" />
            </p:NodeReference>
            <Pin Id="%%p_read_in%%" Name="GeoJSON" Kind="InputPin" />
            <Pin Id="%%p_read_factory%%" Name="Factory" Kind="InputPin" />
            <Pin Id="%%p_read_features%%" Name="Features" Kind="OutputPin" />
            <Pin Id="%%p_read_success%%" Name="Success" Kind="OutputPin" />
            <Pin Id="%%p_read_status%%" Name="Status" Kind="OutputPin" />
            <Pin Id="%%p_read_parses%%" Name="Parses" Kind="OutputPin" />
          </Node>
          <Pad Id="%%pad_success%%" Comment="parsed?" Bounds="400,148,45,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="%%pad_status%%" Comment="status" Bounds="400,183,220,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="%%pad_parses%%" Comment="parses - stays at 1" Bounds="400,218,45,15" ShowValueBox="true" isIOBox="true" />
          <!--
            Count is VL.CoreLib's own node for a Spread. This package does not provide one, and
            that is deliberate: a node a patch can build from nodes it already has is a help
            patch, not a node.
          -->
          <Node Bounds="60,200,44,26" Id="%%n_count%%">
            <p:NodeReference LastCategoryFullName="Collections.Spread" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Count" />
              <CategoryReference Kind="RecordType" Name="Spread" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="%%p_count_in%%" Name="Input" Kind="StateInputPin" />
            <Pin Id="%%p_count_out%%" Name="Count" Kind="OutputPin" />
          </Node>
          <Pad Id="%%pad_count%%" Comment="features" Bounds="150,203,45,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="60,255,52,26" Id="%%n_getslice%%">
            <p:NodeReference LastCategoryFullName="Collections.Spread" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="GetSlice" />
              <CategoryReference Kind="RecordType" Name="Spread" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="%%p_gs_in%%" Name="Input" Kind="StateInputPin" />
            <Pin Id="%%p_gs_default%%" Name="Default Value" Kind="InputPin" />
            <Pin Id="%%p_gs_index%%" Name="Index" Kind="InputPin" />
            <Pin Id="%%p_gs_result%%" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="%%pad_index%%" Comment="which one - try 1" Bounds="150,258,35,15" ShowValueBox="true" isIOBox="true" Value="0">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Integer32" />
            </p:TypeAnnotation>
          </Pad>
          <!--
            Split takes ONE feature apart into its parts. Geometry is a native NetTopologySuite
            Geometry, ready for VL.NetTopologySuite; Properties is a Dictionary, where VL's own
            TryGetValue is waiting. See HowTo Access properties.
          -->
          <Node Bounds="60,310,90,26" Id="%%n_split%%">
            <p:NodeReference LastCategoryFullName="GeoJSON" LastDependency="VL.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Split" />
            </p:NodeReference>
            <Pin Id="%%p_split_in%%" Name="Feature" Kind="InputPin" />
            <Pin Id="%%p_split_geom%%" Name="Geometry" Kind="OutputPin" />
            <Pin Id="%%p_split_props%%" Name="Properties" Kind="OutputPin" />
          </Node>
          <Pad Id="%%pad_geom%%" Comment="geometry" Bounds="60,355,300,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="%%pad_props%%" Comment="all the properties at once" Bounds="60,390,300,15" ShowValueBox="true" isIOBox="true" />
        </Canvas>
        <Patch Id="%%create%%" Name="Create" />
        <Patch Id="%%update%%" Name="Update" />
        <ProcessDefinition Id="%%procdef%%">
          <Fragment Id="%%frag_create%%" Patch="%%create%%" Enabled="true" />
          <Fragment Id="%%frag_update%%" Patch="%%update%%" Enabled="true" />
        </ProcessDefinition>
        <Link Id="%%l1%%" Ids="%%pad_text%%,%%p_read_in%%" />
        <Link Id="%%l2%%" Ids="%%p_read_success%%,%%pad_success%%" />
        <Link Id="%%l3%%" Ids="%%p_read_status%%,%%pad_status%%" />
        <Link Id="%%l4%%" Ids="%%p_read_parses%%,%%pad_parses%%" />
        <Link Id="%%l5%%" Ids="%%p_read_features%%,%%p_count_in%%" />
        <Link Id="%%l6%%" Ids="%%p_count_out%%,%%pad_count%%" />
        <Link Id="%%l7%%" Ids="%%p_read_features%%,%%p_gs_in%%" />
        <Link Id="%%l8%%" Ids="%%pad_index%%,%%p_gs_index%%" />
        <Link Id="%%l9%%" Ids="%%p_gs_result%%,%%p_split_in%%" />
        <Link Id="%%l10%%" Ids="%%p_split_geom%%,%%pad_geom%%" />
        <Link Id="%%l11%%" Ids="%%p_split_props%%,%%pad_props%%" />
      </Patch>
    </Node>
  </Patch>
  <NugetDependency Id="%%dep_geojson%%" Location="VL.GeoJSON" Version="0.0.0" />
</Document>
