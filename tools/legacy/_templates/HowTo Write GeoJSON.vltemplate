<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="%%doc%%" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="%%dep_corelib%%" Location="VL.CoreLib" Version="2025.7.4" />
  <Patch Id="%%patch%%">
    <Canvas Id="%%canvas%%" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="%%app%%">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="%%app_patch%%">
        <Canvas Id="%%app_canvas%%" CanvasType="Group">
          <Pad Id="%%note%%" Bounds="640,60,470,650" ShowValueBox="true" isIOBox="true" Value="A round trip, and why it is the honest test&#xD;&#xA;&#xD;&#xA;This patch reads GeoJSON, writes it straight back out, and reads THAT. If both counts match, nothing was lost.&#xD;&#xA;&#xD;&#xA;Write GeoJSON takes any sequence of features, so the spread out of Read GeoJSON connects, and so does one you built yourself. Note there is no FeatureCollection anywhere - it is a detail of the file format, and this package keeps it there.&#xD;&#xA;&#xD;&#xA;Exact Round Trip - the pin worth understanding&#xD;&#xA;&#xD;&#xA;The standard says a polygon's outer ring winds counter-clockwise and its holes clockwise. With this pin OFF the writer rewinds your rings to obey that: the shape is unchanged, the coordinate ORDER is not. A polygon written and read back is then equal as a shape and unequal as a list of points - a maddening bug to chase. So the default is ON: write exactly what you have.&#xD;&#xA;&#xD;&#xA;What does NOT survive&#xD;&#xA;&#xD;&#xA;The SRID. GeoJSON has nowhere to put one - the format simply declares coordinates are longitude and latitude. Geometry projected into metres is written as if those metres were degrees, and nothing warns you. Convert before writing.&#xD;&#xA;&#xD;&#xA;A GeoJSON id member arrives as an ordinary property called id, and goes back out as one.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">12</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="%%pad_source%%" Comment="GeoJSON in - edit me" Bounds="60,60,540,80" ShowValueBox="true" isIOBox="true" Value="{&quot;type&quot;:&quot;FeatureCollection&quot;,&quot;features&quot;:[{&quot;type&quot;:&quot;Feature&quot;,&quot;geometry&quot;:{&quot;type&quot;:&quot;Point&quot;,&quot;coordinates&quot;:[139.6917,35.6895]},&quot;properties&quot;:{&quot;name&quot;:&quot;Tokyo&quot;,&quot;population&quot;:13960000}},{&quot;type&quot;:&quot;Feature&quot;,&quot;geometry&quot;:{&quot;type&quot;:&quot;Polygon&quot;,&quot;coordinates&quot;:[[[0,0],[4,0],[4,4],[0,4],[0,0]],[[1,1],[1,2],[2,2],[2,1],[1,1]]]},&quot;properties&quot;:{&quot;name&quot;:&quot;a square with a hole&quot;}}]}">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,175,110,26" Id="%%n_read1%%">
            <p:NodeReference LastCategoryFullName="GeoJSON" LastDependency="VL.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Read GeoJSON" />
            </p:NodeReference>
            <Pin Id="%%p_r1_in%%" Name="GeoJSON" Kind="InputPin" />
            <Pin Id="%%p_r1_factory%%" Name="Factory" Kind="InputPin" />
            <Pin Id="%%p_r1_result%%" Name="Features" Kind="OutputPin" />
            <Pin Id="%%p_r1_success%%" Name="Success" Kind="OutputPin" />
            <Pin Id="%%p_r1_status%%" Name="Status" Kind="OutputPin" />
            <Pin Id="%%p_r1_parses%%" Name="Parses" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,230,110,26" Id="%%n_split1%%">
            <p:NodeReference LastCategoryFullName="Collections.Spread" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Count" />
              <CategoryReference Kind="RecordType" Name="Spread" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="%%p_s1_in%%" Name="Input" Kind="StateInputPin" />
            <Pin Id="%%p_s1_count%%" Name="Count" Kind="OutputPin" />
          </Node>
          <Pad Id="%%pad_count_in%%" Comment="features read in" Bounds="330,230,50,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="%%pad_exact%%" Comment="Exact Round Trip - switch it OFF and watch the hole's points reverse" Bounds="60,290,45,20" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="%%pad_indent%%" Comment="Indent - readable output, bigger file" Bounds="60,330,45,20" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,375,110,19" Id="%%n_write%%">
            <p:NodeReference LastCategoryFullName="GeoJSON" LastDependency="VL.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write GeoJSON" />
            </p:NodeReference>
            <Pin Id="%%p_w_features%%" Name="Features" Kind="InputPin" />
            <Pin Id="%%p_w_exact%%" Name="Exact Round Trip" Kind="InputPin" />
            <Pin Id="%%p_w_indent%%" Name="Indent" Kind="InputPin" />
            <Pin Id="%%p_w_result%%" Name="Result" Kind="OutputPin" />
            <Pin Id="%%p_w_success%%" Name="Success" Kind="OutputPin" />
          </Node>
          <Pad Id="%%pad_wrote%%" Comment="wrote ok?" Bounds="60,420,50,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="%%pad_written%%" Comment="GeoJSON out" Bounds="60,460,540,90" ShowValueBox="true" isIOBox="true" />
          <!--
            The written text goes straight back into a second Read GeoJSON. If the counts at
            the top and the bottom agree, the trip was clean.
          -->
          <Node Bounds="60,575,110,26" Id="%%n_read2%%">
            <p:NodeReference LastCategoryFullName="GeoJSON" LastDependency="VL.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Read GeoJSON" />
            </p:NodeReference>
            <Pin Id="%%p_r2_in%%" Name="GeoJSON" Kind="InputPin" />
            <Pin Id="%%p_r2_factory%%" Name="Factory" Kind="InputPin" />
            <Pin Id="%%p_r2_result%%" Name="Features" Kind="OutputPin" />
            <Pin Id="%%p_r2_success%%" Name="Success" Kind="OutputPin" />
            <Pin Id="%%p_r2_status%%" Name="Status" Kind="OutputPin" />
            <Pin Id="%%p_r2_parses%%" Name="Parses" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,630,110,26" Id="%%n_split2%%">
            <p:NodeReference LastCategoryFullName="Collections.Spread" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Count" />
              <CategoryReference Kind="RecordType" Name="Spread" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="%%p_s2_in%%" Name="Input" Kind="StateInputPin" />
            <Pin Id="%%p_s2_count%%" Name="Count" Kind="OutputPin" />
          </Node>
          <Pad Id="%%pad_count_out%%" Comment="features read back - the same number, or something was lost" Bounds="330,630,50,15" ShowValueBox="true" isIOBox="true" />
        </Canvas>
        <Patch Id="%%create%%" Name="Create" />
        <Patch Id="%%update%%" Name="Update" />
        <ProcessDefinition Id="%%procdef%%">
          <Fragment Id="%%frag_create%%" Patch="%%create%%" Enabled="true" />
          <Fragment Id="%%frag_update%%" Patch="%%update%%" Enabled="true" />
        </ProcessDefinition>
        <Link Id="%%l1%%" Ids="%%pad_source%%,%%p_r1_in%%" />
        <Link Id="%%l2%%" Ids="%%p_r1_result%%,%%p_s1_in%%" />
        <Link Id="%%l3%%" Ids="%%p_s1_count%%,%%pad_count_in%%" />
        <Link Id="%%l4%%" Ids="%%p_r1_result%%,%%p_w_features%%" />
        <Link Id="%%l5%%" Ids="%%pad_exact%%,%%p_w_exact%%" />
        <Link Id="%%l6%%" Ids="%%pad_indent%%,%%p_w_indent%%" />
        <Link Id="%%l7%%" Ids="%%p_w_result%%,%%pad_written%%" />
        <Link Id="%%l8%%" Ids="%%p_w_success%%,%%pad_wrote%%" />
        <Link Id="%%l9%%" Ids="%%pad_written%%,%%p_r2_in%%" />
        <Link Id="%%l10%%" Ids="%%p_r2_result%%,%%p_s2_in%%" />
        <Link Id="%%l11%%" Ids="%%p_s2_count%%,%%pad_count_out%%" />
      </Patch>
    </Node>
  </Patch>
  <NugetDependency Id="%%dep_geojson%%" Location="VL.GeoJSON" Version="0.0.0" />
</Document>
