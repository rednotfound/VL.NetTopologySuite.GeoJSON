<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="U3SEOghRV4ZB9XPSJg6tGP" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="UxviCp8hbCXZ7Akm4zkwfP" Location="VL.CoreLib" Version="2025.7.4" />
  <Patch Id="VwFzkqTIudk3WFJ7NuLPzy">
    <Canvas Id="JmiFEp4QOOaaIqTCT5CxZR" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="KjmcUgcOw7SoJDLDctltce">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="AH69EQMw4OCVeKbHgY4mWw">
        <Canvas Id="G5nIfOQBtacZrnoKjmQmjN" CanvasType="Group">
          <Pad Id="CFhuoLqSovHW1j1fdZItZC" Bounds="800,60,470,650" ShowValueBox="true" isIOBox="true" Value="A round trip, and why it is the honest test&#xD;&#xA;&#xD;&#xA;This patch reads GeoJSON, writes it straight back out, and reads THAT. If both counts match, nothing was lost.&#xD;&#xA;&#xD;&#xA;Write GeoJSON takes any sequence of features, so the spread out of Read GeoJSON connects, and so does one you built yourself. Note there is no FeatureCollection anywhere - it is a detail of the file format, and this package keeps it there.&#xD;&#xA;&#xD;&#xA;Exact Round Trip - the pin worth understanding&#xD;&#xA;&#xD;&#xA;The standard says a polygon's outer ring winds counter-clockwise and its holes clockwise. With this pin OFF the writer rewinds your rings to obey that: the shape is unchanged, the coordinate ORDER is not. A polygon written and read back is then equal as a shape and unequal as a list of points - a maddening bug to chase. So the default is ON: write exactly what you have.&#xD;&#xA;&#xD;&#xA;What does NOT survive&#xD;&#xA;&#xD;&#xA;The SRID. GeoJSON has nowhere to put one - the format simply declares coordinates are longitude and latitude. Geometry projected into metres is written as if those metres were degrees, and nothing warns you. Convert before writing.&#xD;&#xA;&#xD;&#xA;A GeoJSON id member arrives as an ordinary property called id, and goes back out as one.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="EmJvvsYsTmMzB6I0gP6hdy" Comment="GeoJSON in - edit me" Bounds="60,60,540,80" ShowValueBox="true" isIOBox="true" Value="{&quot;type&quot;:&quot;FeatureCollection&quot;,&quot;features&quot;:[{&quot;type&quot;:&quot;Feature&quot;,&quot;geometry&quot;:{&quot;type&quot;:&quot;Point&quot;,&quot;coordinates&quot;:[139.6917,35.6895]},&quot;properties&quot;:{&quot;name&quot;:&quot;Tokyo&quot;,&quot;population&quot;:13960000}},{&quot;type&quot;:&quot;Feature&quot;,&quot;geometry&quot;:{&quot;type&quot;:&quot;Polygon&quot;,&quot;coordinates&quot;:[[[0,0],[4,0],[4,4],[0,4],[0,0]],[[1,1],[1,2],[2,2],[2,1],[1,1]]]},&quot;properties&quot;:{&quot;name&quot;:&quot;a square with a hole&quot;}}]}">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,175,110,26" Id="B1OC3ajecXW1K1vJYSrLBr">
            <p:NodeReference LastCategoryFullName="NetTopologySuite.IO" LastDependency="VL.NetTopologySuite.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Read GeoJSON" />
            </p:NodeReference>
            <Pin Id="L8uAPu4M1LjIR1XRobrmiU" Name="GeoJSON" Kind="InputPin" />
            <Pin Id="PL8KAKJAZ63L4EspmKSW5P" Name="Factory" Kind="InputPin" />
            <Pin Id="Bn2Euu3YH51zvkw2XeEHAy" Name="Features" Kind="OutputPin" />
            <Pin Id="B53wvfqFLEVIRz9jWZvqPf" Name="Success" Kind="OutputPin" />
            <Pin Id="JNx5G0qNo9cYOefCBKmYp5" Name="Status" Kind="OutputPin" />
            <Pin Id="MtQzCh3luKcRDkb0DAsoNw" Name="Parses" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,230,110,26" Id="Kjx4OVfQpOdTGADNAurB6u">
            <p:NodeReference LastCategoryFullName="Collections.Spread" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Count" />
              <CategoryReference Kind="RecordType" Name="Spread" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="N8LcnRgPZF4hkExpNBs3hY" Name="Input" Kind="StateInputPin" />
            <Pin Id="Q7sSVMkoH5k7r8VrinbPfI" Name="Count" Kind="OutputPin" />
          </Node>
          <Pad Id="TMSVKo0QMbKoPhSLBn5nh8" Comment="features read in" Bounds="330,230,50,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="OpvAUg0qfhBqLVG43jEjAW" Comment="Exact Round Trip - switch it OFF and watch the hole's points reverse" Bounds="60,290,45,20" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="E6YbuK3DfSKKXHVOCJWWRm" Comment="Indent - readable output, bigger file" Bounds="60,330,45,20" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,375,110,19" Id="Hz7EFi1Zqb8LAsg1QfzEoO">
            <p:NodeReference LastCategoryFullName="NetTopologySuite.IO" LastDependency="VL.NetTopologySuite.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write GeoJSON" />
            </p:NodeReference>
            <Pin Id="PRigkt4IRbWEETzf9ivk1t" Name="Features" Kind="InputPin" />
            <Pin Id="H1TOcbcNLpNxEf5vyeOdVb" Name="Exact Round Trip" Kind="InputPin" />
            <Pin Id="Mg4J3YxLm7NJyM01troPui" Name="Indent" Kind="InputPin" />
            <Pin Id="QOkZL6mfwvs9SfMgNVnBWm" Name="Result" Kind="OutputPin" />
            <Pin Id="AS2S0SUZiJeiKfxLTXPlrs" Name="Success" Kind="OutputPin" />
          </Node>
          <Pad Id="Cvi1pAs1Yem9MNogLzgUNT" Comment="wrote ok?" Bounds="60,420,50,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="ClCGUbrSJzVEdbV7zPonvi" Comment="GeoJSON out" Bounds="60,460,540,90" ShowValueBox="true" isIOBox="true" />
          <!--
            The written text goes straight back into a second Read GeoJSON. If the counts at
            the top and the bottom agree, the trip was clean.
          -->
          <Node Bounds="60,575,110,26" Id="IIAGnIc44NV9rFGgzeNyOO">
            <p:NodeReference LastCategoryFullName="NetTopologySuite.IO" LastDependency="VL.NetTopologySuite.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Read GeoJSON" />
            </p:NodeReference>
            <Pin Id="C8AoWneCBVqJRHBEVzNOl0" Name="GeoJSON" Kind="InputPin" />
            <Pin Id="M1xRnqLIn52bvT0rjFSTbG" Name="Factory" Kind="InputPin" />
            <Pin Id="Nz5XqyLGR3QTXylLMeRluI" Name="Features" Kind="OutputPin" />
            <Pin Id="Ou1VrUOdjeFfQ5jtLqcMfl" Name="Success" Kind="OutputPin" />
            <Pin Id="KSSxeqsZxGrsVYNTOEbTPU" Name="Status" Kind="OutputPin" />
            <Pin Id="Sl0l4Hx3wDOS2d6wIWryW9" Name="Parses" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,630,110,26" Id="HZtiCuqhi0ZGIi3ywGEHkj">
            <p:NodeReference LastCategoryFullName="Collections.Spread" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Count" />
              <CategoryReference Kind="RecordType" Name="Spread" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="AyzAjGrxt9XNLwQdY2gtBX" Name="Input" Kind="StateInputPin" />
            <Pin Id="R5ZqfwDWxSX7ouWxm5LlV8" Name="Count" Kind="OutputPin" />
          </Node>
          <Pad Id="MeJLdaf9Yg7M4GILnJ4rzm" Comment="features read back - the same number, or something was lost" Bounds="330,630,50,15" ShowValueBox="true" isIOBox="true" />
        </Canvas>
        <Patch Id="AYm9J4jI9rttfSX13a1kD7" Name="Create" />
        <Patch Id="TN1Prg6PJAL8nHfogMddBz" Name="Update" />
        <ProcessDefinition Id="LiE4APFO1MnuCm53QKv8Ll">
          <Fragment Id="LspdNk6zMTGoxpYsdeDtQv" Patch="AYm9J4jI9rttfSX13a1kD7" Enabled="true" />
          <Fragment Id="OrNCc2reBDTRJv2T6Iu8r8" Patch="TN1Prg6PJAL8nHfogMddBz" Enabled="true" />
        </ProcessDefinition>
        <Link Id="Okscp0CI6ZQMNlgzQWkKZf" Ids="EmJvvsYsTmMzB6I0gP6hdy,L8uAPu4M1LjIR1XRobrmiU" />
        <Link Id="HgxZSx9cOmwxZKEnI3OADK" Ids="Bn2Euu3YH51zvkw2XeEHAy,N8LcnRgPZF4hkExpNBs3hY" />
        <Link Id="KEzMXDBFR2ivEFq3xACejp" Ids="Q7sSVMkoH5k7r8VrinbPfI,TMSVKo0QMbKoPhSLBn5nh8" />
        <Link Id="U88zeRcIibIY5G7cqZSzMP" Ids="Bn2Euu3YH51zvkw2XeEHAy,PRigkt4IRbWEETzf9ivk1t" />
        <Link Id="NuiTnV8BkH4d5opGoAjc7d" Ids="OpvAUg0qfhBqLVG43jEjAW,H1TOcbcNLpNxEf5vyeOdVb" />
        <Link Id="GyuwHvHImigkF97wfUj2R6" Ids="E6YbuK3DfSKKXHVOCJWWRm,Mg4J3YxLm7NJyM01troPui" />
        <Link Id="UAqtwXRwOg50o31No3gUXy" Ids="QOkZL6mfwvs9SfMgNVnBWm,ClCGUbrSJzVEdbV7zPonvi" />
        <Link Id="HCNAGY5uoWVsxhY6WEHBEu" Ids="AS2S0SUZiJeiKfxLTXPlrs,Cvi1pAs1Yem9MNogLzgUNT" />
        <Link Id="Ja9zrzwYSyPIVzNjj01ShX" Ids="ClCGUbrSJzVEdbV7zPonvi,C8AoWneCBVqJRHBEVzNOl0" />
        <Link Id="ILqCcuOZhw2DnLeFepnhoS" Ids="Nz5XqyLGR3QTXylLMeRluI,AyzAjGrxt9XNLwQdY2gtBX" />
        <Link Id="SRCBswOFT0PXR0FDSDNeS5" Ids="R5ZqfwDWxSX7ouWxm5LlV8,MeJLdaf9Yg7M4GILnJ4rzm" />
      </Patch>
    </Node>
  </Patch>
