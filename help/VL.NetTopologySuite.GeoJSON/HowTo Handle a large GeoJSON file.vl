  <Patch Id="PIM04RQlDrJndWFYkHxpVT">
    <Canvas Id="E1YTsqUrSomosgDw9kyn1q" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="K51DbTFITOo2MqDXTjgIwU">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="KAgwYthZ2huojxWWteSu4O">
        <Canvas Id="Sd1LQJidF9lXO7Nd5UyXo0" CanvasType="Group">
          <Pad Id="VVt2PpIsNNNFdDxPpLDkgI" Bounds="60,-175,480,38" ShowValueBox="true" isIOBox="true" Value="Use GeoJSONReader (Reactive)!">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="UWEpWHW56AeLC1RsHRqWJg" Bounds="60,-133,480,40" ShowValueBox="true" isIOBox="true" Value="A big GeoJSON file takes a while to parse. GeoJSONReader (Reactive) does it on another thread, so vvvv keeps running.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="EpcZvVMuwSqaTnCFAdKolF" Bounds="900,-92,280,40" ShowValueBox="true" isIOBox="true" Value="&lt; 7,342 cities from Natural Earth, public domain. Shipped with this package.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="QmWfFcgxPSJUjErrl2I8Si" Bounds="330,130,210,60" ShowValueBox="true" isIOBox="true" Value="&lt; Reads and parses the file in the background. A new Read cancels the one in progress.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="UUdunIw4VDMjodo80iMjHK" Bounds="120,285,300,45" ShowValueBox="true" isIOBox="true" Value="&lt; Brings the features into the main loop, and keeps the last ones until new ones arrive.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Bo7IMi5NdhzUas9IVwGwfP" Bounds="665,345,330,60" ShowValueBox="true" isIOBox="true" Value="&lt; Read GeoJSON parses on the main loop, and vvvv stops until it is done. Press READ BLOCKING and try to move a node.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="UcrbCE2G6A6AAHDqVVwD89" Bounds="-60,375,600,30" ShowValueBox="true" isIOBox="true" Value="&lt; GeoJSON that is not in a file: put Read GeoJSON in a ForEach [Reactive] region, then HoldLatest.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="RLEoQEmgZ1LlYFAVePiHnd" Bounds="1250,-16,440,420" ShowValueBox="true" isIOBox="true" Value="Reading a big file without freezing vvvv&#xD;&#xA;&#xD;&#xA;Read GeoJSON parses on the main loop, and while it parses everything in vvvv stops - your patch, the renderer, the editor. The 7,342 cities in this file stop it for about half a second; a million features, for more than ten.&#xD;&#xA;&#xD;&#xA;GeoJSONReader (Reactive) reads and parses the file on another thread instead. Its Output is an observable: HoldLatest brings the features into the main loop. In Progress is true while it works, and Progress goes from 0 to 1.&#xD;&#xA;&#xD;&#xA;Read is a bang. OnOpen reads once when the patch opens; READ IN BACKGROUND reads again.&#xD;&#xA;&#xD;&#xA;Memory is the real limit: a few times the file size. Far past a few hundred MB, the answer is a different format - FlatGeobuf, GeoParquet - not a cleverer GeoJSON reader.&#xD;&#xA;&#xD;&#xA;The file carries a legacy crs member. RFC 7946 dropped it; both readers accept it and ignore it.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="DZyWbq65vYkzkpCqXXj02v" Comment="File Path" Bounds="62,-89,505,15" ShowValueBox="true" isIOBox="true" Value="Assets\ne_10m_populated_places_simple.geojson">
