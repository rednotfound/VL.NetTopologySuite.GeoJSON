          <Pad Id="RscSLOj3HjNKDj2G2VpHR8" Comment="FRAMES - climbing, sixty a second, while Parses does not" Bounds="544,300,60,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="60,445,44,26" Id="VhY1SynGqSzKXvDUczpksp">
