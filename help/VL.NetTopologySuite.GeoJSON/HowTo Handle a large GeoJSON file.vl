            <Pin Id="S7G105tsE2LkaP0KyDnKJF" Name="Count" Kind="OutputPin" />
          </Node>
          <Pad Id="LH4ebQNEbp8DWihC2ALOsC" Comment="features" Bounds="62,500,50,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="PoAVCukwoghXUra2KJ9SoE" Comment="status" Bounds="132,261,99,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="254,495,96,88" Id="KLuTAxcqAawQCvFRQxjdbS">
