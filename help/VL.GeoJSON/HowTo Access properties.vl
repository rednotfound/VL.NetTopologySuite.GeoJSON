<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="VynK2Jrx5fRefbTxBEW9sn" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="QBNhJ3h5c8R9lPFAPL6Y4H" Location="VL.CoreLib" Version="2025.7.4" />
  <Patch Id="M9TgEcIhHk4LKTq882f9Mj">
    <Canvas Id="GhN3UMpEAXQzWUyi91ZANE" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="AEuRKO6z3YLpZAyDWqmqVM">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="ILfoHE0EPqXqmgnvBsh4DV">
        <Canvas Id="H7Aq0RW6oZ1Ix57FsXrZ8f" CanvasType="Group">
          <Pad Id="OSr6Un5jRabAEFkMq9vduz" Bounds="930,60,460,620" ShowValueBox="true" isIOBox="true" Value="Two ways to reach a property&#xD;&#xA;&#xD;&#xA;  Split         EVERY property, as a Dictionary&#xD;&#xA;  GetProperty   THIS ONE, by name&#xD;&#xA;&#xD;&#xA;One name box feeds both. Type a name that is not there and both report it - neither throws. That matters: underneath, NetTopologySuite's table THROWS on a missing name, and a node doing that sixty times a second while you type would be useless.&#xD;&#xA;&#xD;&#xA;vvvv ships the same pair for XML - XElement (Split) for all the attributes, GetAttributeValue for one by name with a Success pin.&#xD;&#xA;&#xD;&#xA;What each JSON type arrives as&#xD;&#xA;&#xD;&#xA;  &quot;text&quot;       String&#xD;&#xA;  42           Int64&#xD;&#xA;  1.5          Float64&#xD;&#xA;  true/false   Boolean&#xD;&#xA;  null         reported as not found&#xD;&#xA;  { ... }      a nested table&#xD;&#xA;  [ ... ]      an array&#xD;&#xA;&#xD;&#xA;Whole numbers are Int64, not Float64, on purpose: an OpenStreetMap id is too big for a Float64 to hold exactly.&#xD;&#xA;&#xD;&#xA;A GeoJSON id member becomes an ordinary property. Try typing id.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="LDHquXvPnL3RqE4VsFTPbY" Comment="GeoJSON - edit me" Bounds="60,60,540,90" ShowValueBox="true" isIOBox="true" Value="{&quot;type&quot;:&quot;FeatureCollection&quot;,&quot;features&quot;:[{&quot;type&quot;:&quot;Feature&quot;,&quot;id&quot;:&quot;tokyo&quot;,&quot;geometry&quot;:{&quot;type&quot;:&quot;Point&quot;,&quot;coordinates&quot;:[139.6917,35.6895]},&quot;properties&quot;:{&quot;name&quot;:&quot;Tokyo&quot;,&quot;country&quot;:&quot;JP&quot;,&quot;population&quot;:13960000,&quot;area_km2&quot;:2194.07,&quot;capital&quot;:true,&quot;nickname&quot;:null}},{&quot;type&quot;:&quot;Feature&quot;,&quot;geometry&quot;:{&quot;type&quot;:&quot;Point&quot;,&quot;coordinates&quot;:[13.405,52.52]},&quot;properties&quot;:{&quot;name&quot;:&quot;Berlin&quot;,&quot;country&quot;:&quot;DE&quot;,&quot;population&quot;:3677472,&quot;area_km2&quot;:891.7,&quot;capital&quot;:true}}]}">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,180,110,26" Id="MPvsjde0q1SdMXLPEzIlAs">
            <p:NodeReference LastCategoryFullName="GeoJSON" LastDependency="VL.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Read GeoJSON" />
            </p:NodeReference>
            <Pin Id="GUP5Vatc4txLdDP2SW1Bmq" Name="GeoJSON" Kind="InputPin" />
            <Pin Id="C1NHSXWCVGGZB28uETZ960" Name="Factory" Kind="InputPin" />
            <Pin Id="HrD3fnRLTUPqSBUtzoQMDS" Name="Features" Kind="OutputPin" />
            <Pin Id="ROABng1K25HQQ1G8bfGwIE" Name="Success" Kind="OutputPin" />
            <Pin Id="F7ze7kr2KlxTV42DLxsMhU" Name="Status" Kind="OutputPin" />
            <Pin Id="VPVFhVAm8FNhomASl3shjq" Name="Parses" Kind="OutputPin" />
          </Node>
          <Pad Id="F4EiHgO8cmu3xbGvPnwbmd" Comment="status" Bounds="330,183,250,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="60,240,44,26" Id="DPh2AKohp6OSZxcgoYJpqn">
            <p:NodeReference LastCategoryFullName="Collections.Spread" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Count" />
              <CategoryReference Kind="RecordType" Name="Spread" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="FcUrFpml0tESwQkGrKAPFy" Name="Input" Kind="StateInputPin" />
            <Pin Id="BRUdSVIMKXPe4SXjoSJcEU" Name="Count" Kind="OutputPin" />
          </Node>
          <Pad Id="RIi9DTpJ3pQohh8HYPkYj9" Comment="features" Bounds="150,243,45,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="60,300,52,26" Id="U3v4UWX5DHwFjdR8xbqCBq">
            <p:NodeReference LastCategoryFullName="Collections.Spread" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="GetSlice" />
              <CategoryReference Kind="RecordType" Name="Spread" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="OABmxWYa2nXsfPZazY5D8R" Name="Input" Kind="StateInputPin" />
            <Pin Id="Cr0MsFh5nY20dWN2KzW7ki" Name="Default Value" Kind="InputPin" />
            <Pin Id="SpdIJ4iGkroazPnRsFx5WA" Name="Index" Kind="InputPin" />
            <Pin Id="VOJ2gPpks5s5tj2iSrYkwc" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="HlqAU8fIQ6vkgk8XhHB1gu" Comment="which feature - try 1" Bounds="150,303,35,15" ShowValueBox="true" isIOBox="true" Value="0">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Integer32" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,355,90,26" Id="TKk6PjbIg6PSzr909wvX7F">
            <p:NodeReference LastCategoryFullName="GeoJSON" LastDependency="VL.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Split" />
            </p:NodeReference>
            <Pin Id="Ac7AnLqDp36gzn1ky97HUr" Name="Feature" Kind="InputPin" />
            <Pin Id="N225RosY0xJrunMTwlFaQ9" Name="Geometry" Kind="OutputPin" />
            <Pin Id="MAGf85aJs56ZDhXrVyKC8E" Name="Properties" Kind="OutputPin" />
          </Node>
          <Pad Id="NJj0Q9SjQJSCAE774W50cj" Comment="geometry - goes straight into VL.NetTopologySuite" Bounds="330,358,250,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="R2Q8pIcxJ9avA1y3TLR53k" Comment="every property at once" Bounds="60,400,250,15" ShowValueBox="true" isIOBox="true" />
          <!--
            ONE name box feeding both routes, so they can be compared directly. Try a name that
            is not there: neither throws, both simply say false.
          -->
          <Pad Id="QZK28TnhIdVIMXFvY4nVY8" Comment="property name - try population, capital, id, or a typo" Bounds="330,445,110,15" ShowValueBox="true" isIOBox="true" Value="name">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <!--
            Route 1: take the whole Dictionary from Split, then use VL's OWN TryGetValue. This
            package does not wrap that node, and never will - a node a patch can build from nodes
            it already has is a help patch, not a node.
          -->
          <Node Bounds="60,490,90,26" Id="MSBAKF0aBjRzAVBpNpzXC0">
            <p:NodeReference LastCategoryFullName="Collections.Dictionary" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <CategoryReference Kind="RecordType" Name="Dictionary" />
              <Choice Kind="OperationCallFlag" Name="TryGetValue" />
            </p:NodeReference>
            <Pin Id="Tsv2i5zTdqNxC9O4PxH1Jx" Name="Input" Kind="StateInputPin" />
            <Pin Id="CSklX0pdCfhsat0qLamILD" Name="Key" Kind="InputPin" />
            <Pin Id="TksdQxWRJivXrTRRgucMnc" Name="Result" Kind="OutputPin" />
            <Pin Id="BRpwyFZGjxP8xvd3nlH3PO" Name="Value" Kind="OutputPin" />
          </Node>
          <Pad Id="GfgcqgcypjweMmb50nU8D1" Comment="found?" Bounds="60,535,45,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="NYNUe7oZwYBstfKwsdniuZ" Comment="the value" Bounds="60,570,250,15" ShowValueBox="true" isIOBox="true" />
          <!--
            Route 2: ask the feature directly. Same answer, one node instead of two, and it is
            the shape vvvv uses for XML - a Get.. node always carries a Success pin and never
            throws.
          -->
          <Node Bounds="440,490,100,26" Id="Lt1YTag1xVWh6xyQL3m92n">
            <p:NodeReference LastCategoryFullName="GeoJSON" LastDependency="VL.GeoJSON.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="GetProperty" />
            </p:NodeReference>
            <Pin Id="LYONSWBisxh493OAWBlGtc" Name="Feature" Kind="InputPin" />
            <Pin Id="QRmvaE8vhWNmNSOQfWUZbd" Name="Name" Kind="InputPin" />
            <Pin Id="G4W6jPMXz5QOdwyhbzVmoO" Name="Result" Kind="OutputPin" />
            <Pin Id="Iql7IW7e1eNoPg0mDobvbj" Name="Success" Kind="OutputPin" />
          </Node>
          <Pad Id="UfejMGXSC4eyq6bsPvykyw" Comment="found?" Bounds="440,535,45,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="Kiav7NaCaA0N1cccTLQnbO" Comment="the same value" Bounds="440,570,250,15" ShowValueBox="true" isIOBox="true" />
        </Canvas>
        <Patch Id="ExiSaIgZUWLdLgo2RAwMko" Name="Create" />
        <Patch Id="BTDLZ2zvo2675qNXOW8yeo" Name="Update" />
        <ProcessDefinition Id="ApM3UOyRKbvfJgd0o8TGBv">
          <Fragment Id="UuQuvFpnwdY3ts1OrXvn0c" Patch="ExiSaIgZUWLdLgo2RAwMko" Enabled="true" />
          <Fragment Id="OS0XtMlaOTcb3QWhcLOYLi" Patch="BTDLZ2zvo2675qNXOW8yeo" Enabled="true" />
        </ProcessDefinition>
        <Link Id="Btf6uiZXpknzLNRAwNH2zN" Ids="LDHquXvPnL3RqE4VsFTPbY,GUP5Vatc4txLdDP2SW1Bmq" />
        <Link Id="UMOj3ArO3gtG7WTw8Ah4cb" Ids="F7ze7kr2KlxTV42DLxsMhU,F4EiHgO8cmu3xbGvPnwbmd" />
        <Link Id="M6dmjsdjZu98DJRzgMIQAV" Ids="HrD3fnRLTUPqSBUtzoQMDS,FcUrFpml0tESwQkGrKAPFy" />
        <Link Id="Stp3PbzMdB50xUlbQnURzI" Ids="BRUdSVIMKXPe4SXjoSJcEU,RIi9DTpJ3pQohh8HYPkYj9" />
        <Link Id="IUWi7hE2ZzztCwIDWb7v1L" Ids="HrD3fnRLTUPqSBUtzoQMDS,OABmxWYa2nXsfPZazY5D8R" />
        <Link Id="EucfM7zo9GQJUl6v8xA0Dg" Ids="HlqAU8fIQ6vkgk8XhHB1gu,SpdIJ4iGkroazPnRsFx5WA" />
        <Link Id="R3xxBMW10VGZ7S4HSiUjAu" Ids="VOJ2gPpks5s5tj2iSrYkwc,Ac7AnLqDp36gzn1ky97HUr" />
        <Link Id="FxMlW8Aa6ryeOz3yL9a7Bs" Ids="N225RosY0xJrunMTwlFaQ9,NJj0Q9SjQJSCAE774W50cj" />
        <Link Id="NeUP16ii2saFvlVWpMKfGC" Ids="MAGf85aJs56ZDhXrVyKC8E,R2Q8pIcxJ9avA1y3TLR53k" />
        <Link Id="QhocsgfJf6For3WkzaLhTk" Ids="MAGf85aJs56ZDhXrVyKC8E,Tsv2i5zTdqNxC9O4PxH1Jx" />
        <Link Id="JmonjfIKR7cp4KOxLJLbgS" Ids="QZK28TnhIdVIMXFvY4nVY8,CSklX0pdCfhsat0qLamILD" />
        <Link Id="QDLNCsIgsCu4DUt4uXT4XX" Ids="TksdQxWRJivXrTRRgucMnc,GfgcqgcypjweMmb50nU8D1" />
        <Link Id="IYHw6JCQTLeNXzEeP8oY8I" Ids="BRpwyFZGjxP8xvd3nlH3PO,NYNUe7oZwYBstfKwsdniuZ" />
        <Link Id="QcUlxsXsBbvcEoZ1ZhDhfo" Ids="VOJ2gPpks5s5tj2iSrYkwc,LYONSWBisxh493OAWBlGtc" />
        <Link Id="NF4CmLnf4HefthFWos8cjH" Ids="QZK28TnhIdVIMXFvY4nVY8,QRmvaE8vhWNmNSOQfWUZbd" />
        <Link Id="LH5aekrlfgmhNBGuQbmJQI" Ids="Iql7IW7e1eNoPg0mDobvbj,UfejMGXSC4eyq6bsPvykyw" />
        <Link Id="QEJVgurzBbUz0eJqQkSf1u" Ids="G4W6jPMXz5QOdwyhbzVmoO,Kiav7NaCaA0N1cccTLQnbO" />
      </Patch>
    </Node>
  </Patch>
  <NugetDependency Id="NqhGdYpr6flaHKsqHSMRuX" Location="VL.GeoJSON" Version="0.0.0" />
